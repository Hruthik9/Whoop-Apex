# WHOOP Developer App Credentials
# Create an app at https://developer.whoop.com
WHOOP_CLIENT_ID=your_whoop_client_id_here
WHOOP_CLIENT_SECRET=your_whoop_client_secret_here

# OAuth 2.0 Redirect URI (must match the Redirect URI registered in the WHOOP Developer Portal)
REDIRECT_URI=http://localhost:3000/api/auth/callback

# Server Port
PORT=3000

# WHOOP Developer App Credentials
# Create an app at https://developer.whoop.com
WHOOP_CLIENT_ID=your_whoop_client_id_here
WHOOP_CLIENT_SECRET=your_whoop_client_secret_here

# OAuth 2.0 Redirect URI (must match the Redirect URI registered in the WHOOP Developer Portal)
REDIRECT_URI=http://localhost:3000/api/auth/callback

# Google Health / Fitbit Developer App Credentials (Optional)
# Create credentials in Google Cloud Console or https://dev.fitbit.com
GOOGLE_CLIENT_ID=your_google_or_fitbit_client_id_here
GOOGLE_CLIENT_SECRET=your_google_or_fitbit_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Google Gemini API Key for Apex AI Physiological Copilot (Optional)
# Get a free key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port
PORT=3000

